# Copy this file to ".env" in the same folder and fill in your real values.
# Never commit the real .env file to GitHub.

# From your Stripe Dashboard -> Developers -> API keys (use the "secret" key)
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# From Stripe Dashboard -> Developers -> Webhooks, after you add an endpoint
# pointing at https://yourdomain.com/api/webhook
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# The public URL of your site once deployed (used for Stripe redirect links)
SITE_URL=http://localhost:4242

PORT=4242
